<script context="props">
Category string
Owner string
Question string
Answer string
</script>

<script lang="ts">
let open: boolean = false;
let closed: boolean = true;
let indicator: string = "+";

function toggleAnswer(): void {
  open = !open;
  closed = !open;
  indicator = open ? "−" : "+";
}
</script>

<article class="rounded-2xl bg-white border border-stone-200 p-6">
  <button type="button" on:click={toggleAnswer} aria-expanded={#open} class="w-full text-left cursor-pointer">
    <span class="block text-xs uppercase tracking-widest text-stone-400 mb-2">{Props.Category} · {Props.Owner}</span>
    <span class="flex items-start justify-between gap-4">
      <strong class="font-serif text-xl">{Props.Question}</strong>
      <span class="rounded-full bg-stone-100 px-3 py-1 text-sm">{#indicator}</span>
    </span>
  </button>
  <div show={#open} class:hidden={#closed} class="hidden border-t border-stone-100 pt-5 mt-4">
    <p class="text-sm text-stone-600">{Props.Answer}</p>
  </div>
</article>
