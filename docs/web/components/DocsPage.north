---
import site "github.com/JohnKinyanjui/northframe/docs/internal/site"

interface Props {
  Page site.Page
}
---

<article class="mx-auto w-full max-w-[820px] px-6 py-10 lg:px-12 lg:py-12">
  <template
    class="absolute relative right-4 top-3 mt-12 mt-9 mt-6 mt-5 mt-4 mt-3 mt-0.5 flex hidden h-1.5 w-1.5 shrink-0 select-none scroll-mt-24 space-y-2 gap-3 overflow-x-auto rounded-full rounded-r-xl rounded-xl rounded-md border border-t border-l-4 border-slate-200 border-slate-800 border-sky-500 bg-slate-950 bg-slate-100 bg-sky-50 p-5 px-5 px-1.5 py-0.5 pl-1 pt-10 pt-11 pb-5 text-[1.02rem] text-[0.9em] text-[10px] text-2xl text-xl text-sm font-extrabold font-bold font-semibold leading-8 leading-7 tracking-[0.18em] tracking-tight text-inherit text-slate-950 text-slate-700 text-slate-100 text-slate-500 text-orange-300 text-emerald-300 text-amber-300 text-violet-300 text-sky-300 text-rose-300 text-rose-700 text-sky-900 text-sky-700 uppercase underline no-underline decoration-sky-200 underline-offset-4 shadow-sm hover:text-sky-900"
    ></template>
    <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-sm text-slate-500">
      <a href="/" class="hover:text-slate-950">Docs</a>
      <span>/</span>
      <span>${Props.Page.Section}</span>
      <span>/</span>
      <span class="text-slate-800">${Props.Page.Title}</span>
    </nav>
    <header class="mb-8 border-b border-slate-200 pb-7">
      <h1 class="text-4xl font-extrabold tracking-[-0.035em] text-slate-950 sm:text-5xl">${Props.Page.Title}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">${Props.Page.Description}</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-slate-500">
        <span>v0.1.0-beta documentation</span>
        <span class="text-slate-300">|</span>
        <a href="${Props.Page.EditHref}" class="font-semibold text-slate-600 hover:text-orange-600">Edit this page on
          GitHub ↗</a>
      </div>
    </header>
    <div>{html Props.Page.Content}</div>

    <footer class="mt-14 border-t border-slate-200 pt-7">
      <p class="text-sm font-semibold text-slate-900">Was this page clear?</p>
      <div class="mt-3 flex gap-2">
        <a
          href="${Props.Page.EditHref}"
          class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600 hover:border-orange-300 hover:text-orange-700"
          >Suggest
          an improvement</a>
          <a
            href="https://github.com/JohnKinyanjui/northframe/issues"
            class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600 hover:border-orange-300 hover:text-orange-700"
            >Report
            an issue</a>
          </div>
        </footer>
      </article>
