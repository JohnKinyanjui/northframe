---
import site "github.com/JohnKinyanjui/northframe/docs/internal/site"

interface Props {
  Title      string
  Path       string
  Navigation []site.NavGroup
}
---

<script lang="ts">
  let menuOpen: boolean = false;
  function toggleMenu(): void { menuOpen = !menuOpen; }
  function closeMenu(): void { menuOpen = false; }
  function filterNavigation(event: Event): void {
  if (window.innerWidth < 1024) menuOpen = true;
  const query = (event.currentTarget as HTMLInputElement).value.trim().toLowerCase();
  root.querySelectorAll<HTMLAnchorElement>("[data-doc-link]").forEach((link) => {
  link.hidden = query !== "" && !link.textContent?.toLowerCase().includes(query);
  });
  }

  function buildTableOfContents(): void {
  const target = root.querySelector<HTMLElement>("[data-docs-toc]");
  if (!target) return;
  root.querySelectorAll<HTMLElement>("main article h2, main article h3").forEach((heading) => {
  if (!heading.id) return;
  const link = document.createElement("a");
  link.href = `#${heading.id}`;
  link.textContent = heading.textContent ?? heading.id;
  link.className = heading.tagName === "H3"
  ? "block border-l border-slate-200 py-1 pl-4 text-xs leading-5 text-slate-500 hover:border-orange-400 hover:text-slate-900"
  : "block py-1 text-sm font-medium leading-5 text-slate-600 hover:text-orange-700";
  target.appendChild(link);
  });
  }
  buildTableOfContents();
</script>

<!doctype html>
<html lang="en">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Northframe documentation: native Go SSR, typed browser state, structured routes, and one deployment binary."
    />
    <meta name="theme-color" content="#07111f" />
    <title>${Props.Title} · Northframe</title>
  </head>

  <body class="h-screen overflow-hidden bg-white text-slate-900 antialiased">
    <a
      href="#main-content"
      class="sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:h-auto focus:w-auto focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow-lg"
      >Skip
      to content</a>
      <header
        class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 text-slate-950 shadow-sm backdrop-blur"
      >
        <div class="mx-auto flex h-16 max-w-[1600px] items-center gap-5 px-4 lg:px-6">
          <button
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-lg lg:hidden"
            type="button"
            aria-label="Toggle documentation menu"
            on:click={toggleMenu}
            >☰</button>
            <a href="/" class="flex shrink-0 items-center gap-3" aria-label="Northframe documentation home">
              <img
                src="/logo.png"
                alt=""
                width="40"
                height="40"
                class="h-10 w-10 object-contain"
              />
              <span class="text-lg font-black tracking-tight">Northframe</span>
              <span class="hidden text-sm text-slate-400 sm:inline">Docs</span>
            </a>
            <nav
              class="hidden items-center gap-1 border-l border-slate-200 pl-4 text-sm md:flex"
              aria-label="Primary"
            >
              <a
                href="/getting-started/installation"
                class="rounded-md px-3 py-2 text-slate-600 hover:bg-slate-100 hover:text-slate-950"
                >Guides</a>
                <a
                  href="/reference/cli"
                  class="rounded-md px-3 py-2 text-slate-600 hover:bg-slate-100 hover:text-slate-950"
                  >Reference</a>
                  <a
                    href="/concepts/components"
                    class="rounded-md px-3 py-2 text-slate-600 hover:bg-slate-100 hover:text-slate-950"
                    >Components</a>
                  </nav>
                  <label class="relative ml-auto hidden w-full max-w-sm md:block">
                    <span class="sr-only">Search documentation</span>
                    <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-slate-400">⌕</span>
                    <input
                      data-nav-filter
                      on:input={filterNavigation}
                      type="search"
                      placeholder="Search docs"
                      class="h-10 w-full rounded-lg border border-slate-300 bg-white pl-10 pr-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-500 hover:border-slate-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-100"
                    />
                  </label>
                  <a
                    href="https://github.com/JohnKinyanjui/northframe"
                    class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-950"
                    >GitHub</a>
                  </div>
                </header>

                <div class="mx-auto flex h-[calc(100vh_-_4rem)] min-h-0 max-w-[1600px]">
                  <button
                    show=#{menuOpen}
                    class="fixed inset-0 top-16 z-30 bg-slate-950/50 lg:hidden"
                    type="button"
                    aria-label="Close documentation menu"
                    on:click={closeMenu}
                    ></button>
                    <aside
                      show=#{menuOpen}
                      class="fixed bottom-0 left-0 top-16 z-40 w-[300px] overflow-y-auto border-r border-slate-200 bg-white px-4 py-5 lg:hidden"
                    >
                      <DocsNav Path="${Props.Path}" Navigation=${Props.Navigation} />
                    </aside>
                    <aside
                      class="hidden h-full w-[300px] shrink-0 overflow-y-auto border-r border-slate-200 bg-white px-4 py-5 lg:block"
                    >
                      <DocsNav Path="${Props.Path}" Navigation=${Props.Navigation} />
                    </aside>

                    <main id="main-content" class="h-full min-w-0 flex-1 overflow-y-auto">
                      <slot />
                    </main>

                    <aside
                      class="hidden h-full w-64 shrink-0 overflow-y-auto border-l border-slate-100 px-6 py-10 xl:block"
                    >
                      <h2 class="text-sm font-bold text-slate-900">On this page</h2>
                      <nav data-docs-toc aria-label="On this page" class="mt-3 space-y-1"></nav>
                      <div class="mt-8 border-t border-slate-200 pt-5 text-xs text-slate-500">
                        <a
                          href="https://github.com/JohnKinyanjui/northframe/issues"
                          class="block py-1.5 hover:text-orange-700"
                          >Report
                          an issue ↗</a>
                          <a href="https://github.com/JohnKinyanjui/northframe" class="block py-1.5 hover:text-orange-700">View on GitHub
                            ↗</a>
                        </div>
                      </aside>
                    </div>
                  </body>

                </html>
